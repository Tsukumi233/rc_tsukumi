# Local development only. Replace credentials and targets before deployment.
NODE_ENV=development
REDIS_URL=redis://127.0.0.1:56379
PORT=3000
CALLERS_JSON=[{"id":"demo","token":"demo-token-change-me","allowedOrigins":["http://127.0.0.1:4000"]}]
ALLOW_PRIVATE_TARGETS=true
HTTP_TIMEOUT_MS=10000
LOCK_MS=30000
STALLED_INTERVAL_MS=30000
WORKER_CONCURRENCY=10
MAX_ATTEMPTS=12
NOTIFICATION_TTL_MS=86400000
RETRY_BASE_MS=30000
RETRY_CAP_MS=3600000
